<%@ page language="java" %>
<%
    String user = (String) session.getAttribute("user");
%>

<html>
<body>

<%
    if (user == null) {
%>
        <h2 style="color:red;">Session Expired!</h2>
        <a href="index.jsp">Start Again</a>
<%
    } else {
%>
        <h2>Hello <%= user %>!</h2>
        <p>Your session is still active.</p>
        <a href="checkSession.jsp">Refresh</a>
<%
    }
%>

</body>
</html>